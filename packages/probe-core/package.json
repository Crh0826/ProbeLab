{
  "name": "@probelab/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Engine-independent deterministic probe runner, replay, package validation, and failure minimizer",
  "main": "./dist/index.js",
