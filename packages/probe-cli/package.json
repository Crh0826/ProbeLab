{
  "name": "@probelab/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic ProbeLab command line runner and package tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "probe": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@probelab/core": "0.1.0",
    "@probelab/sandbox": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
