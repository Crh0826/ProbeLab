{
  "name": "@probelab/viewer",
  "version": "0.1.0",
  "description": "Standalone Three.js scene and trace viewer for ProbeLab packages",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-css.mjs"
  },
  "dependencies": {
    "@probelab/core": "0.1.0"
  },
  "peerDependencies": {
    "three": ">=0.186.0 <0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
