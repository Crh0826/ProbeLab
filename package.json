{
  "name": "probelab-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "demo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && npm run test -w @probelab/core && npm run test -w @probelab/audit && npm run test -w @probelab/sandbox && npm run test -w @probelab/cli",
    "dev": "npm run dev -w @probelab/demo",
    "demo": "npm run dev",
    "probe": "node packages/probe-cli/dist/bin.js"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "vite": "8.3.4"
  }
}